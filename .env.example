# Yachiyo 环境变量模板 — 复制为 .env 并填入真实值
# cp .env.example .env && vim .env
#
# ⚠️ .env 已在 .gitignore 中，不会被提交到 GitHub
# ⚠️ 请勿在此文件中填入真实密钥！

# JWT 签名密钥 (生成方式: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET_KEY=***

# 数据库密码
DB_PASSWORD=***

# OpenClaw Gateway
OPENCLAW_ENDPOINT=http://localhost:8100
OPENCLAW_GATEWAY_TOKEN=***
OPENCLAW_MODEL=deepseek/deepseek-v4-flash

# GPT-SoVITS TTS 服务 (可选)
# SOVITS_ENDPOINT=http://localhost:5000

# pgAdmin (可选)
PGADMIN_DEFAULT_PASSWORD=***

# Grafana (可选)
GF_SECURITY_ADMIN_PASSWORD=***

# 域名 (可选，HTTPS 时使用)
# YACHIYO_DOMAIN=

# 部署模式: development | production
ENVIRONMENT=development

# Yachiyo 环境变量配置示例
# 复制本文件为 .env，然后填入实际的值

# ============ 必填 ============

# JWT 签名密钥 — 随机生成 ≥32 字符
JWT_SECRET_KEY=your-random-secret-at-least-32-chars

# PostgreSQL 密码
DB_PASSWORD=your-database-password

# ============ OpenClaw Gateway（必填）============

# Gateway 访问地址
OPENCLAW_ENDPOINT=http://host.docker.internal:8100

# Gateway 认证令牌
OPENCLAW_GATEWAY_TOKEN=your-openclaw-token

# 模型选择
OPENCLAW_MODEL=deepseek/deepseek-v4-flash

# ============ GPT-SoVITS（可选）============

# TTS 服务地址（不部署时留空，系统自动跳过语音合成）
SOVITS_ENDPOINT=http://localhost:5000

# ============ 服务器配置 ==========
SERVER_HOST=0.0.0.0
WEBSOCKET_HOST=0.0.0.0
DB_HOST=localhost
DB_NAME=yachiyo
DB_USER=postgres
REDIS_HOST=localhost

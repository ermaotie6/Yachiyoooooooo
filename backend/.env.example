# Yachiyo CPP 环境变量配置示例
# 复制本文件为 .env，然后填入实际的值

# ==================== 服务器配置 ====================
APP_PORT=8080
APP_HOST=0.0.0.0
APP_THREADS=4
APP_LOG_LEVEL=INFO

# ==================== WebSocket 配置 ====================
WEBSOCKET_PORT=8081
WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_HEARTBEAT_INTERVAL=30
WEBSOCKET_MESSAGE_QUEUE_SIZE=1000
WEBSOCKET_MAX_CONNECTIONS=10000

# ==================== 数据库配置 ====================
# PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/yachiyo"
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=yachiyo
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_POOL_SIZE=20
DATABASE_TIMEOUT=10

# ==================== Redis 配置 ====================
REDIS_ENABLED=false
REDIS_URL="redis://localhost:6379"
REDIS_POOL_SIZE=10
REDIS_PASSWORD=""

# ==================== JWT 配置 ====================
JWT_SECRET_KEY="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

# ==================== OpenAI 配置 ====================
# 获取地址: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-xxxxxxxxxxxx"
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-3.5-turbo"
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=1000

# ==================== DeepSeek 配置 ====================
# 获取地址: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY="sk-xxxxxxxxxxxx"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"
DEEPSEEK_TEMPERATURE=0.7
DEEPSEEK_MAX_TOKENS=4000

# ==================== Openclaw 配置 ====================
# 用于内容审核和安全过滤
OPENCLAW_API_KEY="your-openclaw-api-key"
OPENCLAW_BASE_URL="https://api.openclaw.example.com"
OPENCLAW_ENABLED=true

# ==================== 千问 配置 (阿里云国内版) ====================
# 获取地址: https://dashscope.aliyun.com/api-key_create 或阿里云控制台
# 注意: 千问和 Qwen 国际版使用不同的 API Key，不可通用
QIANWEN_API_KEY="sk-xxxxxxxxxxxx"
QIANWEN_BASE_URL="https://dashscope.aliyuncs.com/api/v1"
QIANWEN_MODEL="qwen-turbo"
QIANWEN_TEMPERATURE=0.7
QIANWEN_MAX_TOKENS=2000

# ==================== Qwen 配置 (国际版 DashScope) ====================
# 获取地址: https://dashscope.aliyun.com
# 注意: 千问和 Qwen 国际版使用不同的 API Key，不可通用
QWEN_INTL_API_KEY="sk-xxxxxxxxxxxx"
QWEN_INTL_BASE_URL="https://dashscope.aliyuncs.com/api/v1"
QWEN_INTL_MODEL="qwen-turbo"
QWEN_INTL_TEMPERATURE=0.7
QWEN_INTL_MAX_TOKENS=2000

# ==================== Ollama 配置 (本地) ====================
# Ollama 无需 API Key，本地部署
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama2"
OLLAMA_TEMPERATURE=0.7
OLLAMA_MAX_TOKENS=1000

# ==================== GPTSoVITS 配置 (TTS) ====================
# 用于文字转语音
GPTSOVITS_BASE_URL="http://localhost:9880"
GPTSOVITS_SPEAKER_ID="默认"
GPTSOVITS_SPEED=1.0
GPTSOVITS_PITCH=1.0

# ==================== Live2D 配置 ====================
# Live2D 模型资源路径
LIVE2D_MODELS_PATH="/models/live2d"
LIVE2D_DEFAULT_MODEL="default"

# ==================== 内容审核配置 ====================
# 审核严格程度: low, medium, high, strict
MODERATION_SEVERITY=medium
# 违规消息处理: delete, hide, flag, review
MODERATION_ACTION=review
# 高风险阈值 (0-1)
HIGH_RISK_THRESHOLD=0.7
# 启用自动审核
AUTO_MODERATION_ENABLED=true

# ==================== 邮件服务配置 ====================
EMAIL_ENABLED=false
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
EMAIL_FROM="noreply@yachiyo.com"
SMTP_USE_TLS=true

# ==================== 日志配置 ====================
LOG_FILE="logs/yachiyo.log"
LOG_MAX_SIZE_MB=100
LOG_MAX_FILES=10
LOG_CONSOLE_OUTPUT=true
LOG_LEVEL=INFO

# ==================== 缓存配置 ====================
CACHE_TTL_SECONDS=3600
USER_CACHE_TTL=1800
CONVERSATION_CACHE_TTL=7200
CACHE_ENABLED=true

# ==================== 安全配置 ====================
PASSWORD_MIN_LENGTH=8
LOGIN_ATTEMPTS_LIMIT=5
LOGIN_LOCKOUT_MINUTES=30
CORS_ENABLED=true
CORS_ORIGINS="*"
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ==================== 环境变量 ====================
ENVIRONMENT=development
APP_NAME=Yachiyo

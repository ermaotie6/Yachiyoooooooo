# 环境配置示例

## 复制此文件为 .env.local 使用

# =======================================
# API 配置
# =======================================

# 后端API基础URL
VITE_API_BASE_URL=http://localhost:8080/api/v1

# API 超时时间 (毫秒)
VITE_API_TIMEOUT=10000

# =======================================
# 应用配置
# =======================================

# 应用名称
VITE_APP_TITLE=Yachiyo Virtual Broadcaster Platform

# 应用版本
VITE_APP_VERSION=2.0.0

# =======================================
# 开发配置
# =======================================

# 调试模式 (true/false)
VITE_DEBUG=true

# 调试日志等级 (log/debug/warn/error)
VITE_LOG_LEVEL=debug

# =======================================
# 功能开关
# =======================================

# 启用 AI 聊天
VITE_ENABLE_CHAT=true

# 启用内容发布
VITE_ENABLE_POST=true

# 启用管理后台
VITE_ENABLE_ADMIN=true

# =======================================
# 安全配置
# =======================================

# JWT 令牌刷新阈值 (秒)
VITE_TOKEN_REFRESH_THRESHOLD=300

# 会话过期时间 (小时)
VITE_SESSION_TIMEOUT=24

# =======================================
# 功能阈值
# =======================================

# 每页显示内容数
VITE_PAGE_SIZE=10

# 最大上传文件大小 (MB)
VITE_MAX_UPLOAD_SIZE=100

# 内容最大长度
VITE_MAX_CONTENT_LENGTH=5000

# =======================================
# 第三方服务
# =======================================

# Openclaw AI 服务已在后端配置
# 前端不需要单独配置

# =======================================
# 功能切换 (灰度发布)
# =======================================

# 启用新版发布页面
VITE_FEATURE_NEW_EDITOR=false

# 启用消息通知系统
VITE_FEATURE_NOTIFICATIONS=true

# 启用直播功能
VITE_FEATURE_LIVE=false

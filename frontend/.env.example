# 环境配置示例

## 复制此文件为 .env.local 使用

# =======================================
# API 配置
# =======================================

# 后端API基础URL
VITE_API_BASE_URL=http://localhost:8080/api/v1

# API v2 基础URL (新API)
VITE_API_V2_BASE_URL=http://localhost:8080/api/v2

# API 超时时间 (毫秒)
VITE_API_TIMEOUT=10000

# =======================================
# WebSocket 配置
# =======================================

# WebSocket 服务器地址
# 留空表示使用相对路径 /ws（由 Vite 代理或 Nginx 转发到后端 WebSocket 服务）
# 也可以设置为完整 URL，如: ws://localhost:9001
VITE_WS_BASE_URL=

# WebSocket 重连间隔 (毫秒)
VITE_WEBSOCKET_RECONNECT_INTERVAL=3000

# WebSocket 心跳间隔 (毫秒)
VITE_WEBSOCKET_HEARTBEAT_INTERVAL=30000

# WebSocket 最大重连次数
VITE_WEBSOCKET_MAX_RECONNECT_ATTEMPTS=10

# =======================================
# 应用配置
# =======================================

# 应用名称
VITE_APP_TITLE=Yachiyo Virtual Broadcaster Platform

# 应用版本
VITE_APP_VERSION=2.0.0

# =======================================
# 开发配置
# =======================================

# 调试模式 (true/false)
VITE_DEBUG=true

# 调试日志等级 (log/debug/warn/error)
VITE_LOG_LEVEL=debug

# =======================================
# 功能开关
# =======================================

# 启用 AI 聊天
VITE_ENABLE_CHAT=true

# 启用内容发布
VITE_ENABLE_POST=true

# 启用管理后台
VITE_ENABLE_ADMIN=true

# 启用直播功能
VITE_ENABLE_LIVE_STREAM=true

# 启用内容审核面板
VITE_ENABLE_MODERATION=true

# =======================================
# 安全配置
# =======================================

# JWT 令牌刷新阈值 (秒)
VITE_TOKEN_REFRESH_THRESHOLD=300

# 会话过期时间 (小时)
VITE_SESSION_TIMEOUT=24

# =======================================
# 功能阈值
# =======================================

# 每页显示内容数
VITE_PAGE_SIZE=10

# 最大上传文件大小 (MB)
VITE_MAX_UPLOAD_SIZE=100

# 内容最大长度
VITE_MAX_CONTENT_LENGTH=5000

# 消息最大长度 (直播间)
VITE_MAX_MESSAGE_LENGTH=500

# =======================================
# Live2D 配置
# =======================================

# Live2D 模型URL
VITE_LIVE2D_MODEL_URL=http://localhost:8080/models/live2d

# Live2D 模型缩放比例
VITE_LIVE2D_SCALE=1.0

# Live2D 口型同步启用
VITE_LIVE2D_MOUTH_SYNC=true

# =======================================
# 音频配置
# =======================================

# 音频输入设备自动选择
VITE_AUDIO_AUTO_SELECT=true

# 音频输出设备自动选择
VITE_AUDIO_OUTPUT_AUTO_SELECT=true

# 音频采样率 (Hz)
VITE_AUDIO_SAMPLE_RATE=16000

# =======================================
# 第三方服务
# =======================================

# Openclaw AI 服务已在后端配置
# 前端不需要单独配置

# =======================================
# 功能切换 (灰度发布)
# =======================================

# 启用新版发布页面
VITE_FEATURE_NEW_EDITOR=false

# 启用消息通知系统
VITE_FEATURE_NOTIFICATIONS=true

# 启用直播功能
VITE_FEATURE_LIVE=true

# 启用内容审核
VITE_FEATURE_CONTENT_MODERATION=true

# 启用高风险消息检测
VITE_FEATURE_HIGH_RISK_DETECTION=true

# =======================================
# 监控和分析
# =======================================

# 启用性能监控
VITE_ENABLE_PERFORMANCE_MONITORING=false

# 启用错误上报
VITE_ENABLE_ERROR_REPORTING=true

# 错误上报地址
VITE_ERROR_REPORTING_URL=http://localhost:8080/api/v1/errors

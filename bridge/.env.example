# ==================== 桥接服务配置 ====================

# 桥接服务监听端口 (接收来自 C++ 后端的请求)
BRIDGE_RECV_PORT=8765

# 桥接服务回调端口 (将 OpenClaw 结果推回 C++ 后端)
BRIDGE_CALLBACK_PORT=8766

# OpenClaw 服务地址
OPENCLAW_ENDPOINT=http://localhost:8000

# OpenClaw API Key (如果需要)
OPENCLAW_API_KEY=

# 请求超时 (毫秒)
REQUEST_TIMEOUT_MS=30000

# 会话过期时间 (秒)
SESSION_TTL_SECONDS=3600

# 日志级别: debug, info, warn, error
LOG_LEVEL=info

# C++ 后端回调地址 (桥接服务将结果 POST 到这里)
BACKEND_CALLBACK_URL=http://localhost:8766
